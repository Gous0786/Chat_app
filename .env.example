# Root env for `docker-compose up` — copy to `.env` (which is gitignored).
#
#   cp .env.example .env
#
# Then edit the values below before running `docker compose up -d`.

# Generate with: openssl rand -base64 32  (or see README for a PowerShell equivalent)
JWT_SECRET_KEY=replace_with_a_random_32plus_character_secret

# Root password for the MySQL container. Change for anything beyond local dev.
MYSQL_ROOT_PASSWORD=root
